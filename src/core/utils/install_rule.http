POST http://localhost:3020/cc HTTP/1.1
Content-Type: text/turtle
Accept: text/turtle

@prefix r: <http://ontology.cf.ericsson.net/reasoner/> .
@prefix : <http://hybridai.org/ontology#> .

<urn:uuid:test-deviation-001> a r:Message ;
  r:to r:KnowledgeBase ;
  r:subject "assert" ;
  r:payload [
    a :KPIDeviation ;
    :source :MiniRocket ;
    :kpiStream "DRB_PdcpSduDelayDl" ;
    :deviationValue "45.2"
  ] .